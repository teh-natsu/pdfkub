<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>io.github.teh_natsu.pdfkub</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>PdfKub</name>
  <summary>Read, organize, combine, split and secure PDFs</summary>
  <developer id="io.github.teh_natsu">
    <name>Nattpol Chaisri</name>
  </developer>
  <description>
    <p>
      PdfKub is an open-source PDF workbench. Read, comment on, fill in and sign PDFs;
      organize, combine and split pages; edit, redact, protect and export documents.
    </p>
  </description>
  <launchable type="desktop-id">io.github.teh_natsu.pdfkub.desktop</launchable>
  <icon type="stock">io.github.teh_natsu.pdfkub</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://github.com/teh-natsu/pdfkub</url>
  <url type="bugtracker">https://github.com/teh-natsu/pdfkub/issues</url>
  <url type="help">https://github.com/teh-natsu/pdfkub</url>
  <categories>
    <category>Office</category>
    <category>Viewer</category>
  </categories>
  <keywords>
    <keyword>pdf</keyword>
    <keyword>viewer</keyword>
    <keyword>annotate</keyword>
    <keyword>forms</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#c9c4ff</color>
    <color type="primary" scheme_preference="dark">#2d2391</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>pdfkub</binary>
    <mediatype>application/pdf</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
